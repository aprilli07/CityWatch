# Backend URL reachable from the device/simulator (see lib/api.ts for per-platform defaults)
EXPO_PUBLIC_API_URL=http://localhost:8000
# Public Mapbox token (pk.*) for map tiles and geocoding
EXPO_PUBLIC_MAPBOX_TOKEN=
# Auth0 application
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
# Optional: secret Mapbox token, only for native builds that still require it
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
