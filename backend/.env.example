# Postgres + PostGIS. Local: postgresql://localhost:5432/citywatch
# Supabase: Project Settings -> Database -> Connection string (URI, session pooler)
DATABASE_URL=postgresql://localhost:5432/citywatch

# Optional: Supabase Storage for report photos (otherwise saved to backend/uploads)
SUPABASE_URL=
SUPABASE_KEY=

# Shared secret for staff endpoints (report status changes, risk refresh)
STAFF_API_TOKEN=

# Optional: Gemini vision severity scoring (falls back to a heuristic)
GEMINI_API_KEY=

# Public URL of this API (used for locally stored photo URLs)
PUBLIC_BASE_URL=http://localhost:8000
